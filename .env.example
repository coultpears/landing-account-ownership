# HubSpot private app token — required for audit commands
# Create one at: HubSpot → Settings → Integrations → Private Apps
# Required scopes:
#   crm.objects.companies.read
#   crm.objects.companies.write   ← required for fix command and owner reassignment
#   crm.objects.deals.read
#   crm.objects.contacts.read
#   sales-email-read
#   crm.objects.owners.read
#   crm.schemas.companies.read
#   crm.schemas.companies.write   ← required to auto-create landing_ownership_rule property
#   crm.associations.read
HUBSPOT_TOKEN=your-private-app-token-here

# Optional: set your HubSpot portal ID to skip one API call on startup
# Find it at: HubSpot → Settings → Account Setup → Account Defaults
HUBSPOT_PORTAL_ID=

# ---------------------------------------------------------------------------
# Slack Bot (Phase 3) — required for server.js
# ---------------------------------------------------------------------------

# Bot token — starts with xoxb-
# Slack App → Install App → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Signing secret — used to verify requests from Slack
# Slack App → Basic Information → App Credentials → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret-here

# App-level token — only needed for Socket Mode (local dev, no public URL)
# Slack App → Basic Information → App-Level Tokens → Generate (scope: connections:write)
# Leave blank when deploying to Cloud Run (HTTP mode is used instead)
SLACK_APP_TOKEN=

# Port for the HTTP server (Cloud Run sets this automatically; default 3000)
PORT=3000

# ---------------------------------------------------------------------------
# /apbot — LLM-powered natural language Slack command
# ---------------------------------------------------------------------------

# Anthropic API key — powers the intent parser (Claude Haiku)
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Launch Dashboard CSV URLs — published Google Sheet tabs
# Google Sheet → File → Share → Publish to web → CSV format
LAUNCH_DASHBOARD_CSV_URL=
LAUNCH_IMPORT_CSV_URL=

# AP Deals sheet — primary source with Partner column, 1000+ properties
# This is the same sheet used by the AP Dashboard (landing-ap-dashboard.netlify.app)
AP_DEALS_CSV_URL=

# ---------------------------------------------------------------------------
# Persistent learnings — GCS bucket for apbot auto-learnings
# ---------------------------------------------------------------------------

# GCS bucket name — learnings persist across container restarts/redeployments
# On Cloud Run, auth uses the service account automatically (no key needed)
# Leave blank for local dev (falls back to data/apbot-learnings.json)
GCS_BUCKET=

# ---------------------------------------------------------------------------
# Observability — Langfuse tracing
# ---------------------------------------------------------------------------

# Langfuse keys — traces every query, tool call, LLM response, cost, latency
# Sign up at https://cloud.langfuse.com (free tier: 50k observations/month)
# Leave blank to disable tracing (no-op, zero overhead)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
